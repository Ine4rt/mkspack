# Le plus simple : python -m mail_agent --setup (pose les questions et écrit .env).
# Sinon, copier ce fichier en .env puis compléter. Ne JAMAIS versionner le fichier .env.

# ---------------------------------------------------------------- Telegram
# Token donné par @BotFather
TELEGRAM_BOT_TOKEN=
# Votre identifiant Telegram NUMÉRIQUE (demandez-le à @userinfobot).
# Plusieurs valeurs possibles, séparées par des virgules. Obligatoire.
TELEGRAM_ALLOWED_USER_IDS=

# ---------------------------------------------------------------- IA (Claude)
ANTHROPIC_API_KEY=
# claude-opus-5 (défaut, meilleure qualité) ; claude-sonnet-5 ou claude-haiku-4-5
# pour réduire les coûts.
LLM_MODEL=claude-opus-5
# low | medium | high : plus bas = plus rapide et moins cher (ignoré pour Haiku)
LLM_EFFORT=medium
# default = repli automatique sur un autre modèle si une requête est refusée ; off = désactivé
LLM_FALLBACKS=default
LLM_MAX_HISTORY_TURNS=12

# ---------------------------------------------------------------- Boîte mail (IMAP)
# Réglages one.com (Gmail : imap.gmail.com / smtp.gmail.com:465 ssl)
IMAP_HOST=imap.one.com
IMAP_PORT=993
IMAP_SSL=true
IMAP_USER=info@ineart.be
# Mot de passe d'application de préférence (Gmail/Outlook : obligatoire avec 2FA)
IMAP_PASSWORD=
IMAP_INBOX=INBOX
# Dossier où copier les mails envoyés. Laisser VIDE pour Gmail (copie automatique).
# Exemples : Sent, "INBOX.Sent", "Éléments envoyés" selon le serveur.
IMAP_SENT_FOLDER=INBOX.Sent

# ---------------------------------------------------------------- Envoi (SMTP)
SMTP_HOST=send.one.com
# 465 + ssl, ou 587 + starttls
SMTP_PORT=587
SMTP_SECURITY=starttls
# Par défaut : mêmes identifiants que l'IMAP
SMTP_USER=
SMTP_PASSWORD=

# ---------------------------------------------------------------- Identité
MAIL_FROM_ADDRESS=info@ineart.be
MAIL_FROM_NAME=Dimitri - Ineart
# Prénom utilisé par l'assistant pour vous parler
ASSISTANT_USER_NAME=Dimitri
# Signature ajoutée à chaque mail envoyé (\n = retour à la ligne)
MAIL_SIGNATURE="Bien à vous,\n\nDimitri\nIneart\nImpression & broderie textile"
# ... ou dans un fichier texte (prioritaire si renseigné)
# MAIL_SIGNATURE_FILE=./signature.txt

# ---------------------------------------------------------------- Voix
# Voix gratuite par défaut (Whisper local + edge-tts).
# Clé OpenAI seulement si STT_PROVIDER/TTS_PROVIDER=openai
OPENAI_API_KEY=

# Transcription : openai | local (faster-whisper, gratuit) | none
STT_PROVIDER=local
STT_MODEL=gpt-4o-mini-transcribe
STT_LANGUAGE=fr
# Pour Groq (alternative compatible, très bon marché) :
# STT_BASE_URL=https://api.groq.com/openai/v1
# STT_API_KEY=gsk_...
# STT_MODEL=whisper-large-v3-turbo
# Pour STT_PROVIDER=local : tiny | base | small | medium
LOCAL_WHISPER_MODEL=small

# Synthèse vocale : edge (gratuit) | openai | none
TTS_PROVIDER=edge
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy
# Voix edge-tts : fr-BE-CharlineNeural, fr-BE-GerardNeural, fr-FR-DeniseNeural…
EDGE_TTS_VOICE=fr-BE-CharlineNeural
# voice_if_voice (réponse vocale si vous avez parlé) | always | never
VOICE_REPLY_MODE=voice_if_voice

# ---------------------------------------------------------------- Divers
DATA_DIR=./data
TIMEZONE=Europe/Brussels
# Durée de validité de la question « Je l'envoie ? » (secondes)
CONFIRMATION_TTL_SECONDS=600
